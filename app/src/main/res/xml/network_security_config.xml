<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuração de segurança de rede da versão final: só HTTPS.
    É o comportamento por omissão a partir do Android 9, mas fica explícito.
    A build de debug substitui este ficheiro por app/src/debug/res/xml/network_security_config.xml.
    Referência: https://developer.android.com/privacy-and-security/security-config
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
