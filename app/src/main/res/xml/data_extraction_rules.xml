<?xml version="1.0" encoding="utf-8"?>
<!--
    Regras de backup (Android 12+): nada da app é copiado para a nuvem nem para outro dispositivo.
    Os dados importantes estão na API; localmente só há a sessão (token) e dados por enviar,
    que não devem ser restaurados noutro telemóvel.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
