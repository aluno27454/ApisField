<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Tema da app, baseado no Material 3 claro.
        A app só tem modo claro (decisão de design), por isso não existe values-night.
    -->
    <style name="Base.Theme.ApisField" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/mel</item>
        <item name="colorOnPrimary">@color/escuro</item>
        <item name="colorPrimaryContainer">@color/mel_claro</item>
        <item name="colorOnPrimaryContainer">@color/escuro</item>
        <item name="colorSecondary">@color/floresta</item>
        <item name="colorOnSecondary">@color/branco</item>
        <item name="colorError">@color/estado_perigo</item>
        <item name="android:colorBackground">@color/claro</item>
        <item name="colorSurface">@color/branco</item>
        <item name="colorOnSurface">@color/escuro</item>
        <item name="colorOnSurfaceVariant">@color/medio</item>
        <item name="colorOutline">@color/borda</item>

        <!-- A barra de estado fica por cima da toolbar escura: ícones claros.
             A barra de navegação fica por cima da barra inferior branca: ícones escuros. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.ApisField" parent="Base.Theme.ApisField" />

    <!-- Toolbar escura com texto claro, como o cabeçalho da Hive Box. -->
    <style name="ThemeOverlay.ApisField.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorOnSurface">@color/claro</item>
    </style>

    <!-- Forma circular para imagens (cantos a 50% do lado). -->
    <style name="ShapeAppearance.ApisField.Circulo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Pílula pequena de texto (sensores, modelo e estado de uma colmeia). -->
    <style name="Widget.ApisField.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/fundo_pilula</item>
        <item name="android:backgroundTint">@color/claro</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">@color/escuro</item>
    </style>

    <!-- Painel: cartões com as contagens, todos com a mesma largura. -->
    <style name="Widget.ApisField.Painel.Contagem" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/fundo_contagem</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">2dp</item>
        <item name="android:paddingVertical">10dp</item>
        <!-- O leitor de ecrã lê o número e o rótulo de uma vez ("3, Saudáveis"). -->
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.ApisField.Painel.ContagemNumero" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:textColor">@color/escuro</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- O texto encolhe se não couber: com letra grande, "Saudáveis" não cabia em cinco colunas. -->
    <style name="Widget.ApisField.Painel.ContagemRotulo" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/medio</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">12sp</item>
    </style>

    <!-- Faixa de aviso (colmeia offline ou vespa detetada). -->
    <style name="Widget.ApisField.Aviso" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/fundo_contagem</item>
        <item name="android:padding">14dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">@color/escuro</item>
    </style>

    <!-- Ecrã Sobre: estilos repetidos nas secções e nos dois autores. -->
    <style name="Widget.ApisField.Sobre.TituloSeccao" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:accessibilityHeading">true</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">@color/mel_escuro</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- O contorno é desenhado metade por dentro e metade por fora da imagem;
         o padding de metade da largura do contorno evita que seja cortado. -->
    <style name="Widget.ApisField.Sobre.FotoAutor" parent="">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:padding">1dp</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ApisField.Circulo</item>
        <item name="strokeColor">@color/mel</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.ApisField.Sobre.NomeAutor" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">@color/escuro</item>
    </style>

    <style name="Widget.ApisField.Sobre.NumeroAutor" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">@color/medio</item>
    </style>
</resources>
